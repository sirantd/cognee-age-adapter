# The production store, pinned exactly (homelab#332, Stage C). Sourced by the
# scripts in this directory. 🚨 Keep each value equal to production: a gate that
# blesses the adapter against a store nobody runs proves less than it says.

# The TrueNAS catalog app `postgres` (app version 1.5.46, image_selector
# v18_pgvector_image), read from the running app on 2026-11-08.
POSTGRES_IMAGE='pgvector/pgvector:0.8.7-pg18-trixie@sha256:5895949dfcdf308eb0cd31c950c93c14895c77f33fbedfecf1fa511ab1d4bcd2'

# The PGDG package whose files production mounts at /opt/age. Its version
# string says rc0, but its source tree is the ASF 1.8.0 release file for file:
# verify-age-source.sh proves that on every run.
AGE_DEB_URL='https://apt.postgresql.org/pub/repos/apt/pool/main/p/postgresql-18-age/postgresql-18-age_1.8.0~rc0-2.pgdg13%2B1_amd64.deb'
AGE_DEB_SHA256='13311da728eb7673249d94c6d1696dfae23cb481a62a884c4b0f5a1fcfed75d2'

# The source of that package, and the ASF release it must equal.
AGE_ORIG_URL='https://apt.postgresql.org/pub/repos/apt/pool/main/p/postgresql-18-age/postgresql-18-age_1.8.0~rc0.orig.tar.gz'
AGE_ORIG_SHA256='c9036f9fb6fe545aa20e333743c661810966288cda9922ac89f4d82d9ee6e99b'
AGE_DEBIAN_URL='https://apt.postgresql.org/pub/repos/apt/pool/main/p/postgresql-18-age/postgresql-18-age_1.8.0~rc0-2.pgdg13%2B1.debian.tar.xz'
AGE_ASF_URL='https://downloads.apache.org/age/PG18/1.8.0/apache-age-1.8.0-src.tar.gz'
AGE_ASF_SHA512='8103dc6a4daec0441c2bdfe4e456be619d04526efa5c4e1a5148a29d7e6359e5df7d9a1fabbc6a6a08f6229c4d6f8634b7bf3554eca8ffb58550382542279866'
